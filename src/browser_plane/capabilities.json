{
  "manifest_version": 1,
  "provider_id": "mac-mm-01",
  "provider_type": "browser",
  "runtime": "mac-browser-plane-r1",
  "production_enabled": true,
  "invocation_mode": "pull_ssh_v1",
  "network": {
    "direct": true,
    "southeast_asia": false,
    "china": false
  },
  "capabilities": {
    "c0_fetch": true,
    "c0_raw_artifact": true,
    "c1_render": true,
    "c1_generic_interaction": false,
    "c2_readonly_inspect": true,
    "c3_browser_use": true,
    "c3_semantic_targeting": true,
    "c3_aria_snapshot": true,
    "c3_browser_agent": false,
    "lightpanda_engine": true,
    "engine_auto_routing": true,
    "persistent_profile": true,
    "screenshot": true,
    "binary_artifact": true,
    "remote_invocation": true,
    "headed_human_takeover": false,
    "c3_actions": [
      "navigate",
      "click",
      "type",
      "select",
      "press",
      "wait",
      "snapshot",
      "screenshot",
      "download"
    ],
    "c3_targeting": [
      "selector",
      "role_with_optional_name",
      "label",
      "text_target"
    ],
    "c3_planning": "external_caller"
  },
  "engine_routing": {
    "policy": "auto_v1",
    "caller_selects_engine": false,
    "engines": [
      "curl",
      "lightpanda",
      "chrome"
    ],
    "rules": {
      "c0_fetch": "curl",
      "c1_ephemeral_js_dom": "lightpanda_then_chrome_fallback",
      "c1_persistent_profile": "chrome",
      "c2_inspect": "chrome",
      "c3_browser_use": "chrome"
    },
    "fallback": {
      "lightpanda_to_chrome": true,
      "scope": "c1_ephemeral_only",
      "only_when_replay_is_side_effect_safe": true
    },
    "lightpanda_process": {
      "transport": "native_fetch_subprocess",
      "persistent_daemon": false,
      "telemetry_disabled": true,
      "core_dump_disabled": true,
      "native_mcp_exposed": false,
      "native_agent_exposed": false
    }
  },
  "security": {
    "tls_verification_required": true,
    "cdp_loopback_only": true,
    "personal_chrome_profile_allowed": false
  },
  "local_agent_adapter": {
    "enabled": true,
    "transport": "stdio",
    "network_listener": false,
    "generic_interaction": true,
    "arbitrary_javascript": false,
    "raw_cdp": false
  },
  "discovery": {
    "status": "operational",
    "recommended_entrypoint": "browser_capabilities",
    "readiness_tool": "browser_doctor",
    "primary_interaction_tool": "browser_use",
    "mcp_server": "mac-browser-plane",
    "mcp_transport": "stdio",
    "agent_planning_location": "caller",
    "documentation": [
      "README.md",
      "AGENTS.md",
      "docs/AI_CAPABILITY_ANNOUNCEMENT.md",
      "docs/IMPLEMENTATION_STATUS.md"
    ],
    "capability_routing": {
      "C0_FETCH": "browser_fetch",
      "C1_RENDER": "browser_render",
      "C2_INSPECT": "browser_inspect",
      "C3_BROWSER_USE": "browser_use"
    }
  }
}
