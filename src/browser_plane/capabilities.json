{
  "manifest_version": 1,
  "provider_id": "mac-mm-01",
  "provider_type": "browser",
  "runtime": "mac-browser-plane-r1",
  "production_enabled": true,
  "invocation_mode": "pull_ssh_v1",
  "network": {
    "direct": true,
    "southeast_asia": false,
    "china": false
  },
  "capabilities": {
    "c0_fetch": true,
    "c0_raw_artifact": true,
    "c1_render": true,
    "c1_content_quality_gate": true,
    "c1_rendered_dom_artifact": true,
    "c1_rendered_dom_artifact_max_bytes": 10000000,
    "c1_generic_interaction": false,
    "c2_readonly_inspect": true,
    "c2_api_candidates": true,
    "c3_browser_use": true,
    "c3_semantic_targeting": true,
    "c3_aria_snapshot": true,
    "c3_browser_agent": false,
    "lightpanda_engine": true,
    "camoufox_engine": true,
    "nodriver_engine": true,
    "engine_auto_routing": true,
    "persistent_profile": true,
    "screenshot": true,
    "binary_artifact": true,
    "artifact_ocr": true,
    "artifact_ocr_signalforge_provider_authorized": false,
    "remote_invocation": true,
    "headed_human_takeover": false,
    "c3_actions": [
      "navigate",
      "click",
      "type",
      "select",
      "press",
      "wait",
      "snapshot",
      "screenshot",
      "download"
    ],
    "c3_targeting": [
      "selector",
      "role_with_optional_name",
      "label",
      "text_target"
    ],
    "c3_planning": "external_caller"
  },
  "artifact_processing": {
    "ocr": {
      "tool": "artifact_ocr",
      "engine": "tesseract",
      "languages": ["mya", "eng"],
      "preferred_model_profile": "tessdata_best",
      "accepted_inputs": ["image/png", "image/jpeg"],
      "input_scope": "runtime_evidence_only",
      "pdf_input": false,
      "network_access": false,
      "local_mcp_authorized": true,
      "codexpro_bridge_authorized": true,
      "signalforge_provider_authorized": false,
      "allowed_psm": [4, 6, 11],
      "max_input_bytes": 26214400,
      "result_semantics": "evidence_enrichment_only_critical_fields_require_source_cross_check"
    }
  },
  "engine_routing": {
    "policy": "auto_v2",
    "caller_selects_engine": false,
    "engines": [
      "curl",
      "lightpanda",
      "chrome",
      "camoufox",
      "nodriver"
    ],
    "rules": {
      "c0_fetch": "curl",
      "c1_ephemeral_js_dom": "lightpanda_then_chrome_fallback",
      "c1_content_quality": "nonempty_rendered_body_v1_fail_closed",
      "c1_persistent_profile": "chrome",
      "c2_inspect": "chrome",
      "c3_browser_use": "chrome",
      "camoufox_c1_c3": "explicit_or_source_evidence_only",
      "nodriver_c1": "explicit_only_ephemeral_no_auto_promotion"
    },
    "fallback": {
      "lightpanda_to_chrome": true,
      "camoufox_automatic_fallback": false,
      "nodriver_automatic_fallback": false,
      "scope": "c1_ephemeral_lightpanda_only",
      "only_when_replay_is_side_effect_safe": true
    },
    "lightpanda_process": {
      "transport": "native_fetch_subprocess",
      "persistent_daemon": false,
      "telemetry_disabled": true,
      "core_dump_disabled": true,
      "native_mcp_exposed": false,
      "native_agent_exposed": false
    },
    "camoufox_process": {
      "transport": "runtime_owned_python_subprocess",
      "persistent_daemon": false,
      "rest_server_exposed": false,
      "native_mcp_exposed": false,
      "jo_camofox_runtime_used": false,
      "persistent_profile_supported": false,
      "proxy_routing_enabled": false
    },
    "nodriver_process": {
      "transport": "runtime_owned_python_subprocess",
      "browser": "system_chrome",
      "headless": true,
      "persistent_daemon": false,
      "native_mcp_exposed": false,
      "persistent_profile_supported": false,
      "c2_supported": false,
      "c3_supported": false
    }
  },
  "security": {
    "tls_verification_required": true,
    "cdp_loopback_only": true,
    "personal_chrome_profile_allowed": false
  },
  "local_agent_adapter": {
    "enabled": true,
    "transport": "stdio",
    "network_listener": false,
    "generic_interaction": true,
    "arbitrary_javascript": false,
    "raw_cdp": false
  },
  "discovery": {
    "status": "operational",
    "recommended_entrypoint": "browser_capabilities",
    "readiness_tool": "browser_doctor",
    "primary_interaction_tool": "browser_use",
    "mcp_server": "mac-browser-plane",
    "mcp_transport": "stdio",
    "agent_planning_location": "caller",
    "documentation": [
      "README.md",
      "AGENTS.md",
      "docs/AI_CAPABILITY_ANNOUNCEMENT.md",
      "docs/IMPLEMENTATION_STATUS.md"
    ],
    "capability_routing": {
      "C0_FETCH": "browser_fetch",
      "C1_RENDER": "browser_render",
      "C2_INSPECT": "browser_inspect",
      "C3_BROWSER_USE": "browser_use",
      "ARTIFACT_OCR": "artifact_ocr"
    },
    "specialized_consumers": {
      "wechat_mp_archive": {
        "repo": "stanleyrprose/wechat-mp-archive",
        "trigger_host": "mp.weixin.qq.com",
        "scope": "known_public_article_urls",
        "pipeline": "C1_CHROME_RENDERED_DOM -> article Markdown/HTML/images/metadata"
      }
    }
  }
}
