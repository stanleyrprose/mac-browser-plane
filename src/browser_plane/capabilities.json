{
  "manifest_version": 1,
  "provider_id": "mac-mm-01",
  "provider_type": "browser",
  "runtime": "mac-browser-plane-r1",
  "production_enabled": false,
  "invocation_mode": "local_cli_only",
  "network": {
    "direct": true,
    "southeast_asia": false,
    "china": false
  },
  "capabilities": {
    "c0_fetch": true,
    "c0_raw_artifact": true,
    "c1_render": true,
    "c1_generic_interaction": false,
    "c2_readonly_inspect": true,
    "c3_browser_use": true,
    "c3_semantic_targeting": true,
    "c3_aria_snapshot": true,
    "c3_browser_agent": false,
    "persistent_profile": true,
    "screenshot": true,
    "binary_artifact": true,
    "remote_invocation": false,
    "headed_human_takeover": false,
    "c3_actions": [
      "navigate",
      "click",
      "type",
      "select",
      "press",
      "wait",
      "snapshot",
      "screenshot",
      "download"
    ],
    "c3_targeting": [
      "selector",
      "role_with_optional_name",
      "label",
      "text_target"
    ],
    "c3_planning": "external_caller"
  },
  "security": {
    "tls_verification_required": true,
    "cdp_loopback_only": true,
    "personal_chrome_profile_allowed": false
  },
  "local_agent_adapter": {
    "enabled": true,
    "transport": "stdio",
    "network_listener": false,
    "generic_interaction": true,
    "arbitrary_javascript": false,
    "raw_cdp": false
  },
  "discovery": {
    "status": "operational",
    "recommended_entrypoint": "browser_capabilities",
    "readiness_tool": "browser_doctor",
    "primary_interaction_tool": "browser_use",
    "mcp_server": "mac-browser-plane",
    "mcp_transport": "stdio",
    "agent_planning_location": "caller",
    "documentation": [
      "README.md",
      "AGENTS.md",
      "docs/AI_CAPABILITY_ANNOUNCEMENT.md",
      "docs/IMPLEMENTATION_STATUS.md"
    ],
    "capability_routing": {
      "C0_FETCH": "browser_fetch",
      "C1_RENDER": "browser_render",
      "C2_INSPECT": "browser_inspect",
      "C3_BROWSER_USE": "browser_use"
    }
  }
}
